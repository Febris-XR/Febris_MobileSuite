    <!--
      Direct reference to the xAPI keystone, required since the PR #5 mobile convergence moved the
      16 xAPI POCOs OUT of Febris.SharedMobileLibrary and into Febris.XApi.Models. This project is a
      LEGACY (non-SDK) csproj, and legacy projects do not inherit transitive ProjectReferences at
      compile time the way SDK-style projects do, so referencing SharedMobileLibrary alone no longer
      makes Febris.ModelLibrary.Models.XApiModels visible here. Without this,
      Utilities/EventHandlers/StatementEventHandlerHelper.cs fails with CS0234.
      The keystone keeps the original namespace on purpose, so no `using` had to change.
    -->
    <PackageReference Include="Febris.XApi.Models" Version="0.1.0" />
