	<uses-permission android:name="android.permission.INSTANT_APP_FOREGROUND_SERVICE" />
	<!-- Screen capture. FOREGROUND_SERVICE is required from API 28 and is what
	     MediaProjection.CreateVirtualDisplay actually gates on from API 29. Note the
	     INSTANT_APP_FOREGROUND_SERVICE line above is a DIFFERENT, unrelated instant-app
	     permission and confers none of this, which is an easy grep false positive.
	     FOREGROUND_SERVICE_MEDIA_PROJECTION only becomes mandatory at targetSdk 34, which
	     a MAUI migration would force, so it is pre-declared here because it costs nothing
	     and is ignored on older platforms. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
	<!-- REQUIRED FROM ANDROID 13 (API 33) AND THIS APP TARGETS 33, so it is enforced, not
	     optional. WiFi Direct peer discovery and connection throw SecurityException without
	     it: ACCESS_FINE_LOCATION no longer covers nearby-device APIs from 13 onward. Its
	     absence is why this head could work years ago and not now, on a platform that has
	     moved three releases underneath it.
	     No neverForLocation flag: this app genuinely does derive location-adjacent
	     information from WiFi scanning, so claiming otherwise would be false. -->
	<uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
	<!-- REQUIRED FROM ANDROID 13 (API 33) to post ANY notification, including the ongoing
	     one the screen-capture foreground service must display. Without it the notification
	     is silently suppressed, and a mediaProjection foreground service that cannot show
	     its notification is exactly the case the platform is designed to stop. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
