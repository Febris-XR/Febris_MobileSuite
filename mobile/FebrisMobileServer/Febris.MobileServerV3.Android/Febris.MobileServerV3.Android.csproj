    <!--
      Declared here as well as in Febris.SharedMobileLibrary, which is where the pairing crypto
      actually consumes it. This is a LEGACY (non-SDK) csproj and does not inherit transitively the
      way an SDK-style project does, which is the same gap the Febris.XApi.Models ProjectReference
      on the Companion head documents. Relying on the transitive path risks an assembly that builds
      green and is then absent from the APK, failing at pairing time on device instead of at build
      time, which is the exact class of error this tier has already lost days to.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
